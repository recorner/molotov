{
  "name": "molotov-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Molotov — Telegram bot (apps/bot) + Sereni web marketplace (apps/web) on one Postgres database",
  "type": "module",
  "workspaces": [
    "apps/bot",
    "apps/web"
  ],
  "scripts": {
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:import": "node scripts/import-sqlite.mjs",
    "bot": "npm --workspace apps/bot run start",
    "web:dev": "npm --workspace apps/web run dev",
    "web:build": "npm --workspace apps/web run build"
  },
  "dependencies": {
    "@prisma/client": "^6.11.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "prisma": "^6.11.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@11.6.0"
}
