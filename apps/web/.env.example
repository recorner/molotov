# =============================================================================
# Sereni — environment variables
# Copy to .env for local dev. On Vercel, set these in Project Settings → Env Vars
# (most are auto-injected when you attach Vercel Postgres + Blob storage).
# =============================================================================

# --- Database (Vercel Postgres / any Postgres) -------------------------------
# Provided automatically when a Vercel Postgres store is attached to the project.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# --- Object storage (Vercel Blob) --------------------------------------------
# Provided automatically when a Vercel Blob store is attached to the project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# --- Auth --------------------------------------------------------------------
# Generate a strong value: `openssl rand -base64 48`
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars

# --- Payments (NOWPayments) --------------------------------------------------
# https://nowpayments.io → Dashboard → Settings
NOWPAYMENTS_API_KEY=your-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=your-nowpayments-ipn-secret
# IPN/webhook endpoint the app exposes. Set this exact URL as the IPN callback
# in the NOWPayments dashboard:  https://<your-domain>/api/payment/ipn
PAYMENT_CALLBACK_URL=https://olesereni.site/api/payment/ipn

# --- Telegram notifications --------------------------------------------------
# The bot must be an admin of the target channel/group to post messages.
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ
# Channel/group that receives admin + payment notifications.
TELEGRAM_ADMIN_CHAT_ID=-1002645332615
TELEGRAM_ADMIN_GROUP_ID=-1002645332615
# Public-facing support handle shown in the UI.
TELEGRAM_SUPPORT_CONTACT=@support

# --- App ---------------------------------------------------------------------
NODE_ENV=production
